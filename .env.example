# ============================================
# KAYAN ERP - Environment Variables
# نظام كيان ERP - متغيرات البيئة
# ============================================

# ============================================
# قاعدة البيانات - Database Configuration
# ============================================
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=KayanERP
DB_USER=sa
DB_PASSWORD=your_password_here

# ملاحظة: غيّر كلمة المرور بكلمة مرور SQL Server الحقيقية
# Note: Change the password to your actual SQL Server password

# ============================================
# إعدادات التطبيق - Application Settings
# ============================================
VITE_APP_NAME=KAYAN ERP
VITE_APP_VERSION=2.1.0
VITE_APP_DESCRIPTION=نظام إدارة الموارد الشامل

# ============================================
# الأمان - Security Settings
# ============================================
# غيّر هذه المفاتيح بقيم عشوائية طويلة وآمنة
# Change these keys to long random secure values

JWT_SECRET=change-this-to-a-very-long-random-secret-key-min-32-characters
SESSION_SECRET=change-this-to-another-long-random-secret-key

# مدة صلاحية الجلسة (بالأيام)
# Session validity period (in days)
SESSION_EXPIRY_DAYS=7

# ============================================
# البيئة - Environment
# ============================================
NODE_ENV=development
# Options: development, production, test

# ============================================
# الخادم - Server Settings
# ============================================
# المنفذ الافتراضي للتطوير
# Default development port
VITE_PORT=5173

# عنوان API (إذا كان منفصل)
# API URL (if separate)
# VITE_API_URL=http://localhost:3000/api

# ============================================
# الإعدادات الإضافية - Additional Settings
# ============================================

# تفعيل وضع التطوير المفصّل
# Enable detailed development mode
DEBUG=false

# اللغة الافتراضية
# Default language
DEFAULT_LANGUAGE=ar

# العملة الافتراضية
# Default currency
DEFAULT_CURRENCY=SAR
DEFAULT_CURRENCY_SYMBOL=ر.س

# معدل الضريبة الافتراضي (%)
# Default tax rate (%)
DEFAULT_TAX_RATE=15

# ============================================
# تعليمات - Instructions
# ============================================
# 1. انسخ هذا الملف وأعد تسميته إلى .env
# 2. غيّر جميع القيم المطلوبة (خاصة كلمات المرور والمفاتيح السرية)
# 3. لا تشارك ملف .env مع أحد
# 4. تأكد من إضافة .env إلى .gitignore

# 1. Copy this file and rename it to .env
# 2. Change all required values (especially passwords and secret keys)
# 3. Never share your .env file with anyone
# 4. Make sure .env is added to .gitignore

